# Copy to .env and fill in. Never commit .env.
GOOGLE_PLACES_API_KEY=your-api-key-here

# Optional: a Postgres connection URL (e.g. from Neon or Supabase) so feedback is kept
# permanently. Leave as-is to use the local SQLite file below.
DATABASE_URL=your-database-url-here

# Local SQLite file used when DATABASE_URL isn't set (relative to app.py)
MOODBITE_DB=moodbite.db
