# On Streamlit Community Cloud, paste these into App settings → Secrets (not into a file in the repo).
# Locally you can also copy this to .streamlit/secrets.toml (gitignored) instead of using .env.
GOOGLE_PLACES_API_KEY = "your-api-key-here"

# Optional but recommended when hosted: keeps feedback across restarts so the app keeps learning.
# Paste the Postgres connection string from Neon/Supabase (it includes ?sslmode=require).
DATABASE_URL = "your-database-url-here"
